# WikiPulse Configuration
# Copy to .env and fill in an API key to enable live LLM responses.
# Without an API key, WikiPulse runs with its built-in heuristic AI fallback.

# Stream mode: "live" (Wikimedia SSE) or "replay" (reads sample_events.jsonl)
WIKIPULSE_MODE=live

# Path to sample JSONL file for replay mode (relative to repo root or absolute)
WIKIPULSE_SAMPLE_FILE=../sample_events.jsonl

# Delay in seconds between replayed events in replay mode (smaller = faster, e.g. 0.1 = fast, 1.0 = slow)
WIKIPULSE_REPLAY_INTERVAL_SECONDS=0.35

# LLM Provider: auto | openai | anthropic | gemini | heuristic
# "auto" picks the first configured API key, or falls back to "heuristic".
LLM_PROVIDER=auto

# Generic API key (auto-detects Anthropic sk-ant-*, Gemini AIza*, or OpenAI-compatible)
LLM_API_KEY=

# Or set a provider-specific key below:
# OpenAI (or any OpenAI-compatible provider like OpenRouter, Groq, or local Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini (optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cost & rate-limit guardrails (protects assessment spending limit)
# Total LLM calls/min, split ~1/3 for Pulse summaries and ~2/3 for vandalism verification
LLM_MAX_CALLS_PER_MINUTE=12
PULSE_REFRESH_MIN_SECONDS=25

# Allowed browser origins for direct (non-proxied) API/WS access.
# Host/port are set on the uvicorn command line (see README).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
